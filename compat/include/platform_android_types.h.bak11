#ifndef PLATFORM_ANDROID_TYPES_H
#define PLATFORM_ANDROID_TYPES_H

/* Opaque Xbox LIVE / marketplace types */
struct XMARKETPLACE_CONTENTOFFER_INFO;
typedef XMARKETPLACE_CONTENTOFFER_INFO* PXMARKETPLACE_CONTENTOFFER_INFO;

struct XCONTENT_DATA;
typedef XCONTENT_DATA* PXCONTENT_DATA;

/* XUI handle (opaque) */
typedef void* HXUIOBJ;

/* Xbox invite info (opaque) */
struct INVITE_INFO;
typedef struct INVITE_INFO INVITE_INFO;

/* Xbox friends / session info (opaque) */
struct FriendSessionInfo;
typedef struct FriendSessionInfo FriendSessionInfo;

/* 4J thread start function (matches World/C4JThread.h) */
typedef int (C4JThreadStartFunc)(void* lpThreadParameter);

/* Xbox LIVE constants */
#ifndef XUSER_INDEX_ANY
#define XUSER_INDEX_ANY                     0x000000FF
#endif

#ifndef XUSER_MAX_COUNT
#define XUSER_MAX_COUNT                     4
#endif

#ifndef XMARKETPLACE_OFFERING_TYPE_CONTENT
#define XMARKETPLACE_OFFERING_TYPE_CONTENT  0x00000001
#endif

/* Xbox user sign-in info: full definition (used as array) */
typedef struct XUSER_SIGNIN_INFO {
    unsigned int dwGuestNumber;
    unsigned long long xuid;
    unsigned int       dwInfoFlags;
    unsigned int       dwUserSigninState;
    unsigned char      _opaque[192];
#ifndef XUSER_GET_SIGNIN_INFO_OFFLINE_XUID_ONLY
#define XUSER_GET_SIGNIN_INFO_OFFLINE_XUID_ONLY 0x00000004
#endif
} XUSER_SIGNIN_INFO;
static inline unsigned int XUserGetSigninInfo(int, unsigned int, XUSER_SIGNIN_INFO*) { return 0; }

#ifdef __cplusplus
/* ============================================================
 * C++ stubs: 4J / Xbox / Sentient types sufficient to compile
 * ============================================================ */

class C_4JProfile {
public:
    struct PROFILESETTINGS;
    int  GetPrimaryPad() const { return 0; }
    void SetPrimaryPad(int) {}
    bool IsSignedIn(int) const { return true; }
    bool IsSignedInLive(int) const { return true; }
    bool IsFullVersion() const { return true; }
    bool IsGuest(int) const { return false; }
    bool AreXUIDSEqual(unsigned long long, unsigned long long) const { return false; }
    void DisplayFullVersionPurchase(bool, int, int) {}
    void ForceQueuedProfileWrites() {}
    void ForceQueuedProfileWrites(int) {}
    unsigned int GetChatAndContentRestrictions(int, bool, int*) { return 0; }
    bool GetDashboardProfileSettings(int, PROFILESETTINGS*) { return false; }
    bool GetGameDefinedProfileData(int) { return false; }
    const wchar_t* GetGamertag(int) const { return L"Player"; }
    bool GetLockedProfile(int) const { return false; }
    bool GetLockedProfile() const { return false; }
    bool ReAwardAchievements(int) { return false; }
    void RemoveGamepadFromGame(int) {}
    void ResetProfileProcessState() {}
    void SetCurrentGameActivity(int, unsigned int, int) {}
    void SetLockedProfile(int) {}
    bool WriteToProfile(int, bool) { return true; }
    bool WriteToProfile(int, bool, bool) { return true; }
    unsigned long long getUserID(int) const { return 0; }
    bool isConnectedToPSN(int) const { return true; }
    bool isSignedInPSN(int) const { return true; }
};
struct C_4JProfile::PROFILESETTINGS {
    unsigned char _opaque[256];
    int  iYAxisInversion;
    bool bSwapSticks;
};

enum eUpsellType { eUpsellType_Undefined = 0, eUpsellType_Custom = 1 };
enum eUpsellResponse { eUpsellResponse_Undefined = 0, eUpsellResponse_Accepted_NoPurchase = 1, eUpsellResponse_Accepted_Purchase = 2 };

enum ESen_FriendOrMatch    { eSen_FriendOrMatch_Unknown    = 0, ESen_FriendOrMatch_Undefined = 0 };
enum ESen_CompeteOrCoop    { ESen_CompeteOrCoop_Undefined    = 0 };
enum ESen_LevelExitStatus { ESen_LevelExitStatus_Undefined = 0, eSen_LevelExitStatus_Exited = 1, eSen_LevelExitStatus_Saved = 2, eSen_LevelExitStatus_NotSaved = 3 };
enum ESen_MediaDestination { ESen_MediaDestination_Undefined = 0 };
enum ESen_MediaType        { ESen_MediaType_Undefined        = 0 };
enum ESen_UpsellID { ESen_UpsellID_Undefined = 0, eSen_UpsellID_Full_Version_Of_Game = 1, eSen_UpsellID_Trial_Expired = 2 };
enum ESen_UpsellOutcome { ESen_UpsellOutcome_Undefined = 0, eSen_UpsellOutcome_Declined = 1, eSen_UpsellOutcome_Went_To_Guide = 2 };
enum ETelemetryChallenges {
    eTelemetryChallenges_Unknown   = 0,
    eTelemetryChallenges_None      = 0,
    ETelemetryChallenges_Undefined = 0
};
#endif /* __cplusplus */




#endif /* PLATFORM_ANDROID_TYPES_H */

/* Global profile manager */
extern C_4JProfile ProfileManager;

/* Xbox 360 presence contexts */
enum {
    CONTEXT_PRESENCE_UNDEFINED              = 0,
    CONTEXT_PRESENCE_MULTIPLAYEROFFLINE     = 1,
    CONTEXT_PRESENCE_MULTIPLAYER            = 2,
    CONTEXT_PRESENCE_MULTIPLAYER_1POFFLINE  = 3,
    CONTEXT_PRESENCE_MULTIPLAYER_1P         = 4,
    CONTEXT_PRESENCE_BUILDING               = 5,
    CONTEXT_PRESENCE_IDLE                   = 6,
    CONTEXT_PRESENCE_MENUS                  = 7,
};

/* Xbox 360 rich presence game state contexts */
enum {
    CONTEXT_GAME_STATE_BLANK        = 0,
    CONTEXT_GAME_STATE_MAIN_MENU    = 1,
    CONTEXT_GAME_STATE_SINGLEPLAYER = 2,
    CONTEXT_GAME_STATE_MULTIPLAYER  = 3,
};

/* Xbox 360 notification constants */
enum {
    XN_SYS_SIGNINCHANGED         = 0x00000001,
    XN_SYS_INPUTDEVICESCHANGED   = 0x00000002,
    XN_SYS_STORAGEDEVICESCHANGED = 0x00000003,
    XN_LIVE_CONTENT_INSTALLED    = 0x00000004,
    XN_LIVE_INVITE_ACCEPTED      = 0x00000005,
};

/* Xbox 360 locale constants (subset) */
enum {
    XC_LOCALE_UNITED_STATES=1, XC_LOCALE_GREAT_BRITAIN, XC_LOCALE_FRANCE, XC_LOCALE_GERMANY,
    XC_LOCALE_ITALY, XC_LOCALE_SPAIN, XC_LOCALE_JAPAN, XC_LOCALE_KOREA,
    XC_LOCALE_CHINA, XC_LOCALE_TAIWAN, XC_LOCALE_HONG_KONG, XC_LOCALE_SINGAPORE,
    XC_LOCALE_AUSTRALIA, XC_LOCALE_NEW_ZEALAND, XC_LOCALE_CANADA, XC_LOCALE_MEXICO,
    XC_LOCALE_BRAZIL, XC_LOCALE_ARGENTINA, XC_LOCALE_CHILE, XC_LOCALE_COLOMBIA,
    XC_LOCALE_AUSTRIA, XC_LOCALE_BELGIUM, XC_LOCALE_CZECH_REPUBLIC, XC_LOCALE_DENMARK,
    XC_LOCALE_FINLAND, XC_LOCALE_GREECE, XC_LOCALE_HUNGARY, XC_LOCALE_INDIA,
    XC_LOCALE_IRELAND, XC_LOCALE_ISRAEL, XC_LOCALE_NETHERLANDS, XC_LOCALE_NORWAY,
    XC_LOCALE_POLAND, XC_LOCALE_PORTUGAL, XC_LOCALE_RUSSIAN_FEDERATION, XC_LOCALE_SAUDI_ARABIA,
    XC_LOCALE_SLOVAK_REPUBLIC, XC_LOCALE_SOUTH_AFRICA, XC_LOCALE_SWEDEN, XC_LOCALE_SWITZERLAND,
    XC_LOCALE_TURKEY, XC_LOCALE_UNITED_ARAB_EMIRATES, XC_LOCALE_LATIN_AMERICA,
    XC_LANGUAGE_SCHINESE, XC_LANGUAGE_TCHINESE,
};

static inline unsigned int XGetLanguage() { return 1; }  /* English */
static inline unsigned int XGetLocale()   { return XC_LOCALE_UNITED_STATES; }

static inline bool IsEqualXUID(unsigned long long a, unsigned long long b) { return a == b; }


