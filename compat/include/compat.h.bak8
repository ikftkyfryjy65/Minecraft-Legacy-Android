#include <cstdio>
static inline int _itoa_s(int value, char* buffer, size_t size, int radix) {
    if (radix == 10) return snprintf(buffer, size, "%d", value);
    if (radix == 16) return snprintf(buffer, size, "%x", value);
    return snprintf(buffer, size, "%d", value);
}
static inline int _i64toa_s(long long value, char* buffer, size_t size, int radix) {
    if (radix == 10) return snprintf(buffer, size, "%lld", value);
    if (radix == 16) return snprintf(buffer, size, "%llx", value);
    return snprintf(buffer, size, "%lld", value);
}

static inline std::wstring convStringToWstring(const wchar_t* ws) {
    return ws ? std::wstring(ws) : std::wstring();
}

