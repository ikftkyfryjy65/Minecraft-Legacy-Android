/* ===== EXTRA (patch 42) — Xbox virtual memory + DLC device ===== */

/* DLC device ID (needed by DLCPack.h, DLCTexturePack.h) */
typedef unsigned int XCONTENTDEVICEID;

/* Xbox 360 virtual memory APIs */
#ifndef MAXULONG_PTR
#define MAXULONG_PTR ((unsigned long long)0xFFFFFFFFFFFFFFFFULL)
#endif
#ifndef PAGE_READWRITE
#define PAGE_READWRITE 0x04
#define PAGE_READONLY  0x02
#endif
#ifndef MEM_LARGE_PAGES
#define MEM_LARGE_PAGES 0x20000000
#define MEM_RESERVE     0x2000
#define MEM_COMMIT      0x1000
#define MEM_RELEASE     0x8000
#endif

static inline void* XPhysicalAlloc(unsigned long long size,
                                   unsigned long long align,
                                   unsigned long long addr,
                                   unsigned int flags) {
    (void)align; (void)addr; (void)flags;
    return malloc((size_t)size);
}
static inline void XPhysicalFree(void* p) { free(p); }
static inline void* XMemSet128(void* dst, int v, size_t n) {
    return memset(dst, v, n);
}

