/* Win32 time APIs (POSIX-backed) */
typedef struct _SYSTEMTIME {
    WORD wYear;
    WORD wMonth;
    WORD wDayOfWeek;
    WORD wDay;
    WORD wHour;
    WORD wMinute;
    WORD wSecond;
    WORD wMilliseconds;
} SYSTEMTIME;

static inline DWORD GetTickCount(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (DWORD)((unsigned long long)ts.tv_sec * 1000ULL
                 + (unsigned long long)ts.tv_nsec / 1000000ULL);
}

static inline void GetLocalTime(SYSTEMTIME* st) {
    if (!st) return;
    time_t t = time(NULL);
    struct tm lt;
    localtime_r(&t, &lt);
    st->wYear = lt.tm_year + 1900;
    st->wMonth = lt.tm_mon + 1;
    st->wDayOfWeek = lt.tm_wday;
    st->wDay = lt.tm_mday;
    st->wHour = lt.tm_hour;
    st->wMinute = lt.tm_min;
    st->wSecond = lt.tm_sec;
    st->wMilliseconds = 0;
}

static inline void GetSystemTime(SYSTEMTIME* st) {
    if (!st) return;
    time_t t = time(NULL);
    struct tm gt;
    gmtime_r(&t, &gt);
    st->wYear = gt.tm_year + 1900;
    st->wMonth = gt.tm_mon + 1;
    st->wDayOfWeek = gt.tm_wday;
    st->wDay = gt.tm_mday;
    st->wHour = gt.tm_hour;
    st->wMinute = gt.tm_min;
    st->wSecond = gt.tm_sec;
    st->wMilliseconds = 0;
}


/* Win32 FILETIME <-> SYSTEMTIME (Windows epoch = 1601-01-01, 100ns ticks) */
#ifndef _WIN32_EPOCH_DELTA_SECONDS
#define _WIN32_EPOCH_DELTA_SECONDS 11644473600ULL
#endif

static inline BOOL SystemTimeToFileTime(const SYSTEMTIME* st, FILETIME* ft) {
    if (!st || !ft) return FALSE;
    struct tm tm;
    memset(&tm, 0, sizeof(tm));
    tm.tm_year = (int)st->wYear - 1900;
    tm.tm_mon  = (int)st->wMonth - 1;
    tm.tm_mday = (int)st->wDay;
    tm.tm_hour = (int)st->wHour;
    tm.tm_min  = (int)st->wMinute;
    tm.tm_sec  = (int)st->wSecond;
    time_t t = timegm(&tm);
    unsigned long long ticks =
        ((unsigned long long)t + _WIN32_EPOCH_DELTA_SECONDS) * 10000000ULL
        + (unsigned long long)st->wMilliseconds * 10000ULL;
    ft->dwLowDateTime  = (DWORD)(ticks & 0xFFFFFFFFULL);
    ft->dwHighDateTime = (DWORD)(ticks >> 32);
    return TRUE;
}

static inline BOOL FileTimeToSystemTime(const FILETIME* ft, SYSTEMTIME* st) {
    if (!ft || !st) return FALSE;
    unsigned long long ticks =
        ((unsigned long long)ft->dwHighDateTime << 32) | ft->dwLowDateTime;
    unsigned long long secs = ticks / 10000000ULL;
    unsigned long long ms   = (ticks % 10000000ULL) / 10000ULL;
    time_t t = (time_t)(secs - _WIN32_EPOCH_DELTA_SECONDS);
    struct tm gt;
    gmtime_r(&t, &gt);
    st->wYear         = (WORD)(gt.tm_year + 1900);
    st->wMonth        = (WORD)(gt.tm_mon + 1);
    st->wDayOfWeek    = (WORD)gt.tm_wday;
    st->wDay          = (WORD)gt.tm_mday;
    st->wHour         = (WORD)gt.tm_hour;
    st->wMinute       = (WORD)gt.tm_min;
    st->wSecond       = (WORD)gt.tm_sec;
    st->wMilliseconds = (WORD)ms;
    return TRUE;
}


/* Xbox 360 XDK memory intrinsics — map to standard C library */
#ifndef XMemCpy
static inline void* XMemCpy(void* dst, const void* src, size_t n) {
    return memcpy(dst, src, n);
}
#endif
#ifndef XMemSet
static inline void* XMemSet(void* dst, int v, size_t n) {
    return memset(dst, v, n);
}
#endif
#ifndef XMemCmp
static inline int XMemCmp(const void* a, const void* b, size_t n) {
    return memcmp(a, b, n);
}
#endif
#ifndef XMemMove
static inline void* XMemMove(void* dst, const void* src, size_t n) {
    return memmove(dst, src, n);
}
#endif


/* ============================================================
 * Win32 Thread-Local Storage (pthread-backed)
 * ============================================================ */
#ifndef TLS_OUT_OF_INDEXES
#define TLS_OUT_OF_INDEXES ((DWORD)0xFFFFFFFF)
#endif
#ifndef TLS_MINIMUM_AVAILABLE
#define TLS_MINIMUM_AVAILABLE 64
#endif

#define COMPAT_TLS_SLOTS 64
static inline DWORD TlsAlloc(void) {
    static __thread int _dummy;
    (void)_dummy;
    static volatile int _next = 0;
    int id = __sync_fetch_and_add(&_next, 1);
    if (id >= COMPAT_TLS_SLOTS) return TLS_OUT_OF_INDEXES;
    return (DWORD)(id + 1);  /* 0 is reserved as invalid */
}

static inline BOOL TlsSetValue(DWORD idx, LPVOID val) {
    if (idx == 0 || idx > COMPAT_TLS_SLOTS) return FALSE;
    static __thread LPVOID _slots[COMPAT_TLS_SLOTS + 1];
    _slots[idx] = val;
    return TRUE;
}

static inline LPVOID TlsGetValue(DWORD idx) {
    if (idx == 0 || idx > COMPAT_TLS_SLOTS) return NULL;
    static __thread LPVOID _slots[COMPAT_TLS_SLOTS + 1];
    return _slots[idx];
}

static inline BOOL TlsFree(DWORD idx) {
    (void)idx;
    return TRUE;
}

