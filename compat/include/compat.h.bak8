/* ============================================================
 * C4JRender — enums + constants only. No implementation.
 * ============================================================ */
#ifdef __cplusplus
class C4JRender {
public:
    enum eTextureFormat {
        TEXTURE_FORMAT_R0G0B0A0    = 0,
        TEXTURE_FORMAT_RGB         = 1,
        TEXTURE_FORMAT_RGBA        = 2,
        TEXTURE_FORMAT_RGBA5551    = 3,
        TEXTURE_FORMAT_RGBA4444    = 4,
        TEXTURE_FORMAT_RGB565      = 5,
        TEXTURE_FORMAT_R1G1B1Ax    = 6,
        TEXTURE_FORMAT_R0G0B0Ax    = 7,
        TEXTURE_FORMAT_RxGxBxAx    = 8,
        TEXTURE_FORMAT_RxGyBzAw    = 9,
        TEXTURE_FORMAT_RxGyBzAw5551= 10,
        TEXTURE_FORMAT_RxGyBzAw4444= 11
    };

    enum eViewportType {
        VIEWPORT_TYPE_FULLSCREEN           = 0,
        VIEWPORT_TYPE_SPLIT_TOP            = 1,
        VIEWPORT_TYPE_SPLIT_BOTTOM         = 2,
        VIEWPORT_TYPE_SPLIT_LEFT           = 3,
        VIEWPORT_TYPE_SPLIT_RIGHT          = 4,
        VIEWPORT_TYPE_QUADRANT_TOP_LEFT    = 5,
        VIEWPORT_TYPE_QUADRANT_TOP_RIGHT   = 6,
        VIEWPORT_TYPE_QUADRANT_BOTTOM_LEFT = 7,
        VIEWPORT_TYPE_QUADRANT_BOTTOM_RIGHT= 8
    };

    enum eVertexType {
        VERTEX_TYPE_PF3_TF2_CB4_NB4_XW1        = 0,
        VERTEX_TYPE_COMPRESSED                 = 1,
        VERTEX_TYPE_PF3_TF2_CB4_NB4_XW1_LIT    = 2,
        VERTEX_TYPE_PF3_TF2_CB4_NB4_XW1_TEXGEN = 3
    };

    enum ePixelShaderType {
        PIXEL_SHADER_TYPE_STANDARD            = 0,
        PIXEL_SHADER_TYPE_PROJECTION          = 1,
        PIXEL_SHADER_TYPE_FORCELOD            = 2,
        PIXEL_SHADER_TYPE_DEBUG               = 3,
        PIXEL_SHADER_TYPE_Gamma               = 4,
        PIXEL_SHADER_TYPE_LOD_FORCE           = 5,
        PIXEL_SHADER_TYPE_STANDARD_COMPRESSED = 6,
        PIXEL_SHADER_COUNT                    = 7
    };

    enum ePrimitiveType {
        PRIMITIVE_TYPE_TRIANGLE_LIST  = 0,
        PRIMITIVE_TYPE_TRIANGLE_STRIP = 1,
        PRIMITIVE_TYPE_TRIANGLE_FAN   = 2,
        PRIMITIVE_TYPE_QUAD_LIST      = 3,
        PRIMITIVE_TYPE_LINE_LIST      = 4,
        PRIMITIVE_TYPE_LINE_STRIP     = 5
    };
    void UpdateGamma(unsigned short) {}
    bool IsHiDef() const { return true; }

    void TextureDataUpdate(int, int, int, void*) {}
    void* TextureData(int) { return 0; }
    bool IsWidescreen() const { return true; }
    void StateSetLightEnable(int, bool) {}
    void StateSetForceLOD(int) {}
    void StateSetEnableViewportClipPlanes(bool) {}
    void DrawVertices(int, int, int, void*) {}
    void CBuffClear(int) {}
    void LoadTextureData(const char*) {}
    void CBuffCall(int, int) {}
    void TextureSetTextureLevels(int, int) {}
    void TextureFree(int) {}
    int  TextureCreate() { return 0; }
    void TextureBindVertex(int, int) {}
    void TextureBind(int) {}
    void StateSetLightingEnable(bool) {}
    void StateSetFogEnable(bool) {}
    void StateSetFaceCull(bool) {}
    void StateSetDepthTestEnable(bool) {}
    void StateSetColour(float, float, float, float) {}
    void StateSetBlendEnable(bool) {}
    void StateSetAlphaTestEnable(bool) {}
    void MatrixScale(float, float, float) {}
    bool InitialiseContext(void*) { return true; }
};
#endif


/* ============================================================
 * std::random_shuffle was removed in C++17.
 * Provide a macro that redirects to std::shuffle.
 * ============================================================ */
#ifdef __cplusplus
#include <algorithm>
#include <random>
namespace compat_shuffle_ns {
    inline std::mt19937& rng() {
        static std::mt19937 g(0);
        return g;
    }
}
#define random_shuffle(first, last) \
    shuffle((first), (last), ::compat_shuffle_ns::rng())
#endif


#ifdef __cplusplus
#include <functional>
#include <string>
#include <cstddef>

/* std::hash_value — legacy MSVC/Boost pattern used by Player.cpp.
 * Modern STL does NOT provide this; add overloads in namespace std. */
namespace std {
    inline std::size_t hash_value(const std::wstring& s) {
        return std::hash<std::wstring>()(s);
    }
    inline std::size_t hash_value(const std::string& s) {
        return std::hash<std::string>()(s);
    }
    inline std::size_t hash_value(const char* p) {
        return std::hash<const void*>()(static_cast<const void*>(p));
    }
    inline std::size_t hash_value(const wchar_t* p) {
        return std::hash<const void*>()(static_cast<const void*>(p));
    }
}
#define compat_std_hash 1
#endif


/* Java-style boolean types (JNI / legacy Java code) */
