/* ===== Patch 54: PlayerUID central definition ===== */
#ifndef COMPAT_PLAYERUID_DEFINED
#define COMPAT_PLAYERUID_DEFINED 1

#ifdef __cplusplus
#include <string>
#include <functional>
#include <cstdio>
#include <cwchar>
#include <iostream>
#include <sstream>

struct PlayerUID {
    unsigned long long v;
    PlayerUID() : v(0) {}
    PlayerUID(unsigned long long x) : v(x) {}
    operator unsigned long long() const { return v; }

    struct Hash {
        size_t operator()(const PlayerUID& p) const {
            return std::hash<unsigned long long>()(p.v);
        }
    };

    std::wstring toString() const {
        wchar_t buf[32];
        swprintf(buf, 32, L"%llx", v);
        return std::wstring(buf);
    }

    bool operator==(const PlayerUID& o) const { return v == o.v; }
    bool operator!=(const PlayerUID& o) const { return v != o.v; }
    bool operator< (const PlayerUID& o) const { return v <  o.v; }
};

inline std::wistream& operator>>(std::wistream& is, PlayerUID& p) {
    unsigned long long tmp = 0;
    is >> tmp;
    p.v = tmp;
    return is;
}
inline std::wostream& operator<<(std::wostream& os, const PlayerUID& p) {
    os << p.v;
    return os;
}
inline std::ostream& operator<<(std::ostream& os, const PlayerUID& p) {
    os << p.v;
    return os;
}

namespace std {
    template<>
    struct hash<PlayerUID> {
        size_t operator()(const PlayerUID& p) const {
            return std::hash<unsigned long long>()(p.v);
        }
    };
}
#endif

#endif /* COMPAT_PLAYERUID_DEFINED */


