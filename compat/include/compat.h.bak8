/* ===== Patch 44: memory status ===== */
typedef struct _MEMORYSTATUS {
    unsigned int  dwLength;
    unsigned int  dwMemoryLoad;
    size_t        dwTotalPhys;
    size_t        dwAvailPhys;
    size_t        dwTotalPageFile;
    size_t        dwAvailPageFile;
    size_t        dwTotalVirtual;
    size_t        dwAvailVirtual;
} MEMORYSTATUS, *LPMEMORYSTATUS;

static inline void GlobalMemoryStatus(MEMORYSTATUS* ms) {
    if (!ms) return;
    ms->dwLength = sizeof(*ms);
    ms->dwMemoryLoad = 50;
    ms->dwTotalPhys = (size_t)8ULL * 1024 * 1024 * 1024;
    ms->dwAvailPhys = (size_t)4ULL * 1024 * 1024 * 1024;
    ms->dwTotalPageFile = ms->dwTotalPhys;
    ms->dwAvailPageFile = ms->dwAvailPhys;
    ms->dwTotalVirtual = ms->dwTotalPhys;
    ms->dwAvailVirtual = ms->dwAvailPhys;
}

/* ===== Patch 45: Win32 Interlocked family (GCC/Clang builtins) ===== */

static inline long InterlockedIncrement(volatile long* p) {
    return __sync_add_and_fetch(p, 1);
}
static inline long InterlockedDecrement(volatile long* p) {
    return __sync_sub_and_fetch(p, 1);
}
static inline long InterlockedExchange(volatile long* p, long v) {
    return __sync_lock_test_and_set(p, v);
}
static inline long InterlockedCompareExchange(volatile long* p, long ex, long cmp) {
    return __sync_val_compare_and_swap(p, cmp, ex);
}
static inline long long InterlockedIncrement64(volatile long long* p) {
    return __sync_add_and_fetch(p, 1);
}
static inline long long InterlockedDecrement64(volatile long long* p) {
    return __sync_sub_and_fetch(p, 1);
}
static inline long long InterlockedExchange64(volatile long long* p, long long v) {
    return __sync_lock_test_and_set(p, v);
}
static inline long long InterlockedCompareExchange64(volatile long long* p,
                                                     long long ex, long long cmp) {
    return __sync_val_compare_and_swap(p, cmp, ex);
}

/* Xbox 360 variants with memory barrier */
static inline long long InterlockedCompareExchangeRelease64(volatile long long* p,
                                                            long long ex, long long cmp) {
    return __sync_val_compare_and_swap(p, cmp, ex);
}
static inline long long InterlockedCompareExchangeAcquire64(volatile long long* p,
                                                            long long ex, long long cmp) {
    return __sync_val_compare_and_swap(p, cmp, ex);
}
static inline long InterlockedCompareExchangeRelease(volatile long* p, long ex, long cmp) {
    return __sync_val_compare_and_swap(p, cmp, ex);
}
static inline long InterlockedCompareExchangeAcquire(volatile long* p, long ex, long cmp) {
    return __sync_val_compare_and_swap(p, cmp, ex);
}

static inline long InterlockedAdd(volatile long* p, long v) {
    return __sync_add_and_fetch(p, v);
}
static inline long long InterlockedAdd64(volatile long long* p, long long v) {
    return __sync_add_and_fetch(p, v);
}

static inline void* InterlockedExchangePointer(void* volatile* pp, void* v) {
    return __sync_lock_test_and_set(pp, v);
}
static inline void* InterlockedCompareExchangePointer(void* volatile* pp,
                                                      void* ex, void* cmp) {
    return __sync_val_compare_and_swap(pp, cmp, ex);
}

