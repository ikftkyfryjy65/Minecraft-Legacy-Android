);

BOOL SetThreadPriority(
    HANDLE hThread,
    int nPriority
);

SIZE_T SetThreadAffinityMask(
    HANDLE hThread,
    SIZE_T dwThreadAffinityMask
);

void Sleep(DWORD dwMilliseconds);

