/* Patch 84: more Win32 + DirectXMath */
#include <cstdarg>
#include <cstdio>
static inline int _vsnprintf_s(char* buf, size_t sz, size_t count, const char* fmt, va_list ap) {
    (void)count; return vsnprintf(buf, sz, fmt, ap);
}
static inline int vsnprintf_s(char* buf, size_t sz, size_t count, const char* fmt, va_list ap) {
    (void)count; return vsnprintf(buf, sz, fmt, ap);
}
static inline int _snprintf_s(char* buf, size_t sz, size_t count, const char* fmt, ...) {
    (void)count; va_list ap; va_start(ap, fmt); int r = vsnprintf(buf, sz, fmt, ap); va_end(ap); return r;
}
#ifndef XMMatrixDeterminant
static inline XMVECTOR XMMatrixDeterminant(const XMMATRIX&) { XMVECTOR v = {}; return v; }
#endif
#ifndef XMMatrixInverse
static inline XMMATRIX XMMatrixInverse(const XMVECTOR*, const XMMATRIX&) { XMMATRIX r = {}; return r; }
