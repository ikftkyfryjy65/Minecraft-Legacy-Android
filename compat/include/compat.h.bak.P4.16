#include <cstdio>
static inline int _itoa_s(int value, char* buffer, size_t size, int radix) {
    if (radix == 10) return snprintf(buffer, size, "%d", value);
    if (radix == 16) return snprintf(buffer, size, "%x", value);
    return snprintf(buffer, size, "%d", value);
}
static inline int _i64toa_s(long long value, char* buffer, size_t size, int radix) {
    if (radix == 10) return snprintf(buffer, size, "%lld", value);
    if (radix == 16) return snprintf(buffer, size, "%llx", value);
    return snprintf(buffer, size, "%lld", value);
}

static inline std::wstring convStringToWstring(const wchar_t* ws) {
    return ws ? std::wstring(ws) : std::wstring();
}

/* ===== AUTO-BULK GL constants (Patch 81) — Android uses GLES, these match desktop GL names */

/* Xbox extras (Patch 82) */
static inline unsigned int XEnableGuestSignin(bool) { return 0; }
#ifndef D3DXIMAGE_INFO
typedef struct { unsigned int Width; unsigned int Height; unsigned int Depth; unsigned int MipLevels; int Format; int ResourceType; int ImageFileFormat; } D3DXIMAGE_INFO;
#endif
#include <cwchar>
#include <cstdarg>
static inline int swscanf_s(const wchar_t* buf, const wchar_t* fmt, ...) {
    if (!buf || !fmt) return 0;
    va_list ap; va_start(ap, fmt);
    int r = vswscanf(buf, fmt, ap);
    va_end(ap); return r;
}

/* Patch 83: Win32 + DX types */
typedef long long LONG64;
typedef unsigned long long ULONG64;
#ifndef _TRUNCATE
#define _TRUNCATE ((size_t)-1)
#endif
#ifndef ULARGE_INTEGER
typedef union _ULARGE_INTEGER { struct { unsigned int LowPart; unsigned int HighPart; }; unsigned long long QuadPart; } ULARGE_INTEGER;
#endif
#ifndef D3DXVECTOR3
typedef struct { float x, y, z; } D3DXVECTOR3;
#endif
/* DirectXMath (minimal — Android build uses GLES) */
#ifndef XMFLOAT4
typedef struct { float x, y, z, w; } XMFLOAT4;
#endif
#ifndef XMVECTOR
typedef struct { float v[4]; } XMVECTOR;
#endif
#ifndef XMMATRIX
typedef struct XMMATRIX {
    union {
        float m[4][4];
        struct { float r[4][4]; };
    };
    float* operator[](int i) { return m[i]; }
    const float* operator[](int i) const { return m[i]; }
} XMMATRIX;
#endif
static inline XMMATRIX XMMatrixIdentity() { XMMATRIX r = {}; r.m[0][0]=r.m[1][1]=r.m[2][2]=r.m[3][3]=1; return r; }
static inline XMMATRIX XMMatrixMultiply(const XMMATRIX& a, const XMMATRIX& b) { XMMATRIX r = {}; return r; }
static inline void* GetModuleHandle(const char*) { return 0; }
static inline void* GetModuleHandleA(const char*) { return 0; }
static inline void* GetModuleHandleW(const wchar_t*) { return 0; }
enum { XONLINE_S_LOGON_CONNECTION_ESTABLISHED = 0 };

