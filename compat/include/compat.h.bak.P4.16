static inline XMVECTOR XMLoadFloat4(const XMFLOAT4* src) { XMVECTOR v = {}; return v; }
static inline XMVECTOR XMVectorSet(float x, float y, float z, float w) { XMVECTOR v; v.v[0]=x; v.v[1]=y; v.v[2]=z; v.v[3]=w; return v; }
static inline XMVECTOR XMVectorSubtract(const XMVECTOR& a, const XMVECTOR& b) { XMVECTOR r; for (int i=0;i<4;i++) r.v[i]=a.v[i]-b.v[i]; return r; }
static inline XMVECTOR XMVectorAdd(const XMVECTOR& a, const XMVECTOR& b) { XMVECTOR r; for (int i=0;i<4;i++) r.v[i]=a.v[i]+b.v[i]; return r; }
static inline XMMATRIX XMMatrixTranslation(float, float, float) { XMMATRIX r = {}; r.m[0][0]=r.m[1][1]=r.m[2][2]=r.m[3][3]=1; return r; }
static inline XMMATRIX XMMatrixScaling(float, float, float) { XMMATRIX r = {}; r.m[0][0]=r.m[1][1]=r.m[2][2]=r.m[3][3]=1; return r; }
static inline XMMATRIX XMMatrixRotationX(float) { XMMATRIX r = {}; r.m[0][0]=r.m[1][1]=r.m[2][2]=r.m[3][3]=1; return r; }
static inline XMMATRIX XMMatrixRotationY(float) { XMMATRIX r = {}; r.m[0][0]=r.m[1][1]=r.m[2][2]=r.m[3][3]=1; return r; }
static inline XMMATRIX XMMatrixRotationZ(float) { XMMATRIX r = {}; r.m[0][0]=r.m[1][1]=r.m[2][2]=r.m[3][3]=1; return r; }

