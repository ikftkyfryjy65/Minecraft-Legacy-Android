#include <stdio.h>
static inline void OutputDebugStringW(const wchar_t* s) {
    if (s) fwprintf(stderr, L"%ls", s);
}
static inline void OutputDebugStringA(const char* s) {
    if (s) fprintf(stderr, "%s", s);
}

#include <wchar.h>
static inline wchar_t* _itow(int v, wchar_t* buf, int radix) {
    if (!buf) return NULL;
    switch (radix) {
        case 10: swprintf(buf, 32, L"%d", v); break;
        case 16: swprintf(buf, 32, L"%x", v); break;
        case 8:  swprintf(buf, 32, L"%o", v); break;
        default: buf[0] = 0;
    }
    return buf;
}

