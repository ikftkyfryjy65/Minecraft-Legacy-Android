/* Xbox 360 XDK lock-free stack — fallback stub.
 * Real semantics matter only for concurrent tile storage;
 * single-threaded fallback is sufficient for compilation and initial boot. */
#ifdef __cplusplus
template<typename T, int Alignment = 4>
class XLockFreeStack {
public:
    XLockFreeStack() {}
    ~XLockFreeStack() {}
    void Push(T* /*item*/) {}
    T*   Pop()    { return nullptr; }
    T*   PopAll() { return nullptr; }
    bool IsEmpty() const { return true; }
    void Purge() {}
};
#endif


