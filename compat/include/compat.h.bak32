typedef long long           LONGLONG;
typedef long long           __int64;

typedef int                 BOOL;

typedef void                VOID;
typedef void*               LPVOID;
typedef const void*         LPCVOID;

typedef char                CHAR;
typedef wchar_t             WCHAR;

typedef WCHAR*              LPWSTR;
typedef const WCHAR*        LPCWSTR;

typedef BYTE*               PBYTE;

typedef size_t              SIZE_T;

/*
 * HRESULT
 */
typedef long HRESULT;

/* ============================================================
 * Common constants
