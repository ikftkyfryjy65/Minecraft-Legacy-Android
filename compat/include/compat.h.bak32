/* ============================================================
 * Boost-style hash_value helpers (used by Minecraft.World/Hasher.cpp).
 * On Android we provide generic overloads for common types.
 * ============================================================ */
#ifdef __cplusplus
#include <functional>
#include <string>
#include <cstddef>

namespace compat_hash {
    template<typename T>
    inline std::size_t hash_value(const T& v) {
        return std::hash<T>()(v);
    }

    inline std::size_t hash_value(const std::string& s) {
        return std::hash<std::string>()(s);
    }

    inline std::size_t hash_value(const std::wstring& s) {
        return std::hash<std::wstring>()(s);
    }

    inline std::size_t hash_value(int v)                { return std::hash<int>()(v); }
    inline std::size_t hash_value(unsigned int v)       { return std::hash<unsigned int>()(v); }
    inline std::size_t hash_value(long v)               { return std::hash<long>()(v); }
    inline std::size_t hash_value(unsigned long v)      { return std::hash<unsigned long>()(v); }
    inline std::size_t hash_value(long long v)          { return std::hash<long long>()(v); }
    inline std::size_t hash_value(unsigned long long v) { return std::hash<unsigned long long>()(v); }
    inline std::size_t hash_value(float v)              { return std::hash<float>()(v); }
    inline std::size_t hash_value(double v)             { return std::hash<double>()(v); }
    inline std::size_t hash_value(const void* p)        { return std::hash<const void*>()(p); }
}

using compat_hash::hash_value;
#endif /* __cplusplus */


