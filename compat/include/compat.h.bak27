typedef long long           LONGLONG;
typedef long long           __int64;

typedef int                 BOOL;

typedef void                VOID;
typedef void*               LPVOID;
typedef const void*         LPCVOID;

typedef char                CHAR;
typedef wchar_t             WCHAR;

typedef WCHAR*              LPWSTR;
