#endif

/* ============================================================
 * Xbox 360 LZX compression API stubs
 * Real implementation deferred to a later phase (Phase 6).
 * Signatures preserved; behaviour returns failure.
 * ============================================================ */
#ifndef XMEMCODEC_LZX
#define XMEMCODEC_LZX 0x0001
#endif

typedef struct _XMEMCODEC_PARAMETERS_LZX {
    unsigned int Flags;
    unsigned int WindowSize;
    unsigned int CompressionPartitionSize;
} XMEMCODEC_PARAMETERS_LZX;

typedef void* XMEMCOMPRESSION_CONTEXT;
typedef void* XMEMDECOMPRESSION_CONTEXT;

static inline int XMemCreateCompressionContext(unsigned int codec,
                                              const XMEMCODEC_PARAMETERS_LZX* params,
                                              unsigned int flags,
                                              XMEMCOMPRESSION_CONTEXT* ctx) {
    (void)codec; (void)params; (void)flags;
    if (ctx) *ctx = NULL;
    return 0;  /* failure — real impl TBD */
}

static inline int XMemCreateDecompressionContext(unsigned int codec,
                                                const XMEMCODEC_PARAMETERS_LZX* params,
                                                unsigned int flags,
                                                XMEMDECOMPRESSION_CONTEXT* ctx) {
    (void)codec; (void)params; (void)flags;
    if (ctx) *ctx = NULL;
    return 0;
}

static inline void XMemDestroyCompressionContext(XMEMCOMPRESSION_CONTEXT ctx) { (void)ctx; }
static inline void XMemDestroyDecompressionContext(XMEMDECOMPRESSION_CONTEXT ctx) { (void)ctx; }

static inline int XMemCompress(XMEMCOMPRESSION_CONTEXT ctx,
                               void* dst, SIZE_T* dstSize,
                               const void* src, SIZE_T srcSize) {
    (void)ctx; (void)dst; (void)src; (void)srcSize;
    if (dstSize) *dstSize = 0;
    return 0;
}
static inline int XMemCompress(XMEMCOMPRESSION_CONTEXT ctx,
                               void* dst, DWORD* dstSize,
                               const void* src, DWORD srcSize) {
    (void)ctx; (void)dst; (void)src; (void)srcSize;
    if (dstSize) *dstSize = 0;
    return 0;
}

static inline int XMemDecompress(XMEMDECOMPRESSION_CONTEXT ctx,
                                 void* dst, SIZE_T* dstSize,
                                 const void* src, SIZE_T srcSize) {
    (void)ctx; (void)dst; (void)src; (void)srcSize;
    if (dstSize) *dstSize = 0;
    return 0;
}
static inline int XMemDecompress(XMEMDECOMPRESSION_CONTEXT ctx,
                                 void* dst, DWORD* dstSize,
                                 const void* src, DWORD srcSize) {
    (void)ctx; (void)dst; (void)src; (void)srcSize;
    if (dstSize) *dstSize = 0;
    return 0;
}


/* Win32 fixed-width signed integers */
#ifndef __int8
typedef signed char         __int8;
#endif
#ifndef __int16
typedef short               __int16;
#endif
#ifndef __int32
typedef int                 __int32;
#endif
#ifndef __int64
typedef long long           __int64;
#endif

/* Xbox 360 XDK lock-free stack — fallback stub.
 * Real semantics matter only for concurrent tile storage;
 * single-threaded fallback is sufficient for compilation and initial boot. */
#ifdef __cplusplus
template<typename T, int Alignment = 4>
class XLockFreeStack {
public:
    XLockFreeStack() {}
    ~XLockFreeStack() {}
    void Push(T* /*item*/) {}
    T*   Pop()    { return nullptr; }
    T*   PopAll() { return nullptr; }
    bool IsEmpty() const { return true; }
    void Purge() {}
};
#endif


