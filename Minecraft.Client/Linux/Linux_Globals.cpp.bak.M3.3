/* M3.1: EGL Command Channel Bridge */
#include <sys/mman.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>
#include <stdint.h>
#include <stdio.h>

#define MCE_MAGIC   0x4D434531u
#define CMD_CLEAR   1
#define CMD_PRESENT 2
#define CMD_DRAW    3

struct MCECmdExt {
    volatile uint32_t magic;
    volatile uint32_t seq;
    volatile uint32_t cmd;
    volatile float    params[8];
    volatile uint32_t result;
    volatile uint32_t pad[8];
};

static MCECmdExt* g_mce_cmd = nullptr;
static int g_mce_cmd_fd = -1;

static void __attribute__((constructor(150)))
mce_cmd_bridge_init() {
    const char* path = getenv("MCE_CMD_PATH");
    if (!path) return;
    g_mce_cmd_fd = open(path, O_RDWR);
    if (g_mce_cmd_fd < 0) return;
    void* p = mmap(nullptr, 4096, PROT_READ|PROT_WRITE, MAP_SHARED, g_mce_cmd_fd, 0);
    if (p == MAP_FAILED) { g_mce_cmd = nullptr; return; }
    g_mce_cmd = (MCECmdExt*)p;
    if (g_mce_cmd->magic != MCE_MAGIC) { g_mce_cmd = nullptr; return; }
    fprintf(stderr, "[bridge] CMD channel attached: %s\n", path);

    /* === A2 TEST: send a RED color immediately === */
    g_mce_cmd->params[0] = 0.95f;  /* r - RED */
    g_mce_cmd->params[1] = 0.15f;  /* g */
    g_mce_cmd->params[2] = 0.15f;  /* b */
    g_mce_cmd->params[3] = 1.0f;   /* a */
    g_mce_cmd->cmd = CMD_DRAW;
    __sync_synchronize();
    g_mce_cmd->seq++;
    fprintf(stderr, "[bridge] Test RED sent (seq=1)\n");
}

static inline void mce_send(uint32_t cmd, float r, float g, float b, float a) {
    if (!g_mce_cmd) return;
    g_mce_cmd->params[0] = r;
    g_mce_cmd->params[1] = g;
    g_mce_cmd->params[2] = b;
    g_mce_cmd->params[3] = a;
    g_mce_cmd->cmd = cmd;
    __sync_synchronize();
    g_mce_cmd->seq = g_mce_cmd->seq + 1;
}

